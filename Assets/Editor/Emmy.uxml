<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
>

    <Style src="Emmy.uss" />

    <ui:VisualElement class="screen-root">

        <ui:VisualElement class="emmy-window">

            <ui:TabView
                reorderable="false"
                class="emmy-tabs"
            >

                <ui:Tab label="Settings">

                     <ui:ScrollView
        class="settings-scroll"
        mode="Vertical"
    >

                        <ui:VisualElement class="settings-panel">

                            <ui:VisualElement class="settings-section">

                                <ui:Label
                                    text="Agent Characteristics"
                                    class="section-title"
                                />

                                <ui:DropdownField
                                    label="Agent Type"
                                    name="agent-type-dropdown"
                                    class="settings-field"
                                />

                                <ui:TextField
                                    label="Custom Character Prompt"
                                    name="custom-prompt-field"
                                    multiline="true"
                                    class="settings-field custom-prompt-field"
                                />

                            </ui:VisualElement>


                            <ui:VisualElement class="settings-section">

                                <ui:Label
                                    text="Select Models"
                                    class="section-title"
                                />

                                <ui:DropdownField
                                    label="Large Language Model"
                                    name="llm-dropdown"
                                    class="settings-field"
                                />

                                <ui:DropdownField
                                    label="Text-to-Speech Model"
                                    name="tts-dropdown"
                                    class="settings-field"
                                />

                                <ui:DropdownField
                                    label="Voice"
                                    name="tts-voice-dropdown"
                                    class="settings-field"
                                />

                            </ui:VisualElement>


                            <ui:Button
                                text="Start"
                                name="save-settings-button"
                                class="primary-button"
                            />

                        </ui:VisualElement>

                    </ui:ScrollView>

                </ui:Tab>


                <ui:Tab label="Conversation History">

                    <ui:ScrollView
                        name="conversation-scroll"
                        class="conversation-scroll"
                    />

                </ui:Tab>

            </ui:TabView>

        </ui:VisualElement>

   <ui:Button
        name="settings-wrench-button"
        text="⚙"
        class="settings-wrench"
    />
    
    </ui:VisualElement>

</ui:UXML>