.screen-root {
    flex-grow: 1;

    align-items: flex-end;
    justify-content: center;

    padding-right: 30px;
    padding-top: 30px;
    padding-bottom: 30px;
}

.emmy-window {
    width: 380px;
    height: 440px;

    background-color: rgb(225, 225, 225);

    border-radius: 10px;
}

.emmy-tabs {
    flex-grow: 1;
}

.settings-scroll {
    flex-grow: 1;
    height: 520px;
    /* min-height: 0; */
}

.settings-wrench {
    position: absolute;

    right: 20px;
    top: 20px;

    width: 42px;
    height: 42px;

    font-size: 20px;

    border-radius: 21px;
}

.settings-panel {
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.settings-section {
    margin-bottom: 20px;
}

.section-title {
    -unity-font-style: bold;

    font-size: 16px;

    margin-bottom: 12px;
}

.settings-field {
    margin-bottom: 10px;
}

.custom-prompt-field {
    min-height: 80px;
}

.primary-button {
    height: 38px;

    margin-top: 10px;
}

.conversation-scroll {
    flex-grow: 1;

    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
}