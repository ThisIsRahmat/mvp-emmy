<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
>

    <Style src="Settings.uss" />

    <ui:VisualElement class="screen-root" picking-mode="Ignore">

        <ui:VisualElement
            name="settings-window"
            class="emmy-window"
        >

            <ui:VisualElement
                name="settings-header"
                class="settings-header"
            >

                <ui:Label
                    text="Settings"
                    class="settings-title"
                />

            </ui:VisualElement>

            <ui:TabView
                name="emmy-tab-view"
                reorderable="false"
                class="emmy-tabs"
            >

                <ui:Tab label="Settings">

                    <ui:ScrollView
                        class="settings-scroll"
                        mode="Vertical"
                    >

                        <ui:VisualElement class="settings-panel">

                            <ui:VisualElement class="settings-section">

                                <ui:Label
                                    text="Personalise Agent"
                                    class="section-title"
                                />

                                <ui:DropdownField
                                    label="Agent Type"
                                    name="agent-type-dropdown"
                                    class="settings-field"
                                />

                                <ui:TextField
                                    label="Custom Character Prompt"
                                    name="custom-prompt-field"
                                    multiline="true"
                                    class="settings-field custom-prompt-field"
                                />

                            </ui:VisualElement>

                            <ui:VisualElement class="settings-section">

    


                                <ui:DropdownField
                                    label="Agent Voice"
                                    name="tts-voice-dropdown"
                                    class="settings-field"
                                />

                            </ui:VisualElement>

                            <ui:Button
                                text="Start"
                                name="save-settings-button"
                                class="primary-button"
                            />

                        </ui:VisualElement>

                    </ui:ScrollView>

                </ui:Tab>

                <ui:Tab label="Conversation History">

                    <ui:ScrollView
                        name="conversation-scroll"
                        class="conversation-scroll"
                    />

                </ui:Tab>

            </ui:TabView>

        </ui:VisualElement>

        <ui:Button
            name="settings-wrench-button"
            text="⚙"
            class="settings-wrench"
        />

    

    </ui:VisualElement>

</ui:UXML>