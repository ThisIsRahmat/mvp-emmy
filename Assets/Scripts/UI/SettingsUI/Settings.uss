.screen-root {
    flex-grow: 1;

    align-items: flex-end;
    justify-content: center;

    padding-right: 30px;
    padding-top: 30px;
    padding-bottom: 30px;
}

.emmy-window {
    position: absolute;
    right: 30px;
    top: 30px;

    width: 380px;
    height: 440px;

    background-color: rgb(225, 225, 225);

    padding-top: 8px;
    padding-right: 8px;
    padding-left: 8px;

    border-radius: 10px;
}

.settings-header {
    flex-direction: row;
    align-items: center;

    margin-bottom: 4px;
}

.settings-title {
    flex-grow: 1;

    font-size: 18px;
    -unity-font-style: bold;
}

.emmy-tabs {
    flex-grow: 1;
}

.settings-scroll {
    flex-grow: 1;
    min-height: 0;
}

.settings-wrench {
    position: absolute;

    right: 20px;
    top: 20px;

    width: 42px;
    height: 42px;

    font-size: 20px;

    border-radius: 21px;
}

.settings-panel {
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
}

.settings-section {
    margin-bottom: 20px;
}

.section-title {
    -unity-font-style: bold;

    font-size: 16px;

    margin-bottom: 12px;
}

.settings-field {
    margin-bottom: 10px;
}

.custom-prompt-field {
    min-height: 80px;
}

.primary-button {
    height: 38px;

    margin-top: 10px;
}

.conversation-scroll {
    flex-grow: 1;

    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
}

.chat-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.chat-row--user {
    justify-content: flex-end;
}

.chat-row--agent {
    justify-content: flex-start;
}

.chat-row--file {
    justify-content: center;
}

.chat-bubble {
    max-width: 260px;

    padding-top: 8px;
    padding-right: 12px;
    padding-bottom: 8px;
    padding-left: 12px;

    border-radius: 14px;

    white-space: normal;
    font-size: 13px;
}

.chat-bubble--user {
    background-color: rgb(60, 120, 246);
    color: rgb(255, 255, 255);
}

.chat-bubble--agent {
    background-color: rgb(235, 235, 235);
    color: rgb(20, 20, 20);

    border-width: 1px;
    border-color: rgb(210, 210, 210);
}

.chat-bubble--file {
    background-color: rgba(60, 189, 108, 0.15);
    color: rgb(40, 110, 70);

    border-width: 1px;
    border-color: rgb(60, 189, 108);
    border-radius: 10px;

    padding-top: 4px;
    padding-right: 10px;
    padding-bottom: 4px;
    padding-left: 10px;

    font-size: 11px;
    -unity-font-style: italic;
}