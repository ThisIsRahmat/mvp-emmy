<ui:UXML xmlns:ui="UnityEngine.UIElements">

    <Style src="Files.uss" />

  <ui:VisualElement
    class="files-root"
    picking-mode="Ignore"
>

        <ui:VisualElement
            name="files-window"
            class="files-window"
        >

            <ui:VisualElement
                name="files-header"
                class="files-header"
            >

                <ui:Label
                    text="Project Files"
                    class="files-title"
                />

                <ui:Button
                    name="close-files-button"
                    text="×"
                    class="close-files-button"
                />

            </ui:VisualElement>

            <ui:Label
                text="Files Emmy can see. Drag a file onto the folder icon to add more."
                class="files-description"
            />

            <ui:ScrollView
                name="files-scroll"
                class="files-scroll"
                mode="Vertical"
            >

              <ui:Label
    name="empty-files-label"
    text="No project files loaded."
    class="empty-files-label"
    picking-mode="Ignore"
/>

            </ui:ScrollView>

            <ui:VisualElement
                name="files-resize-handle"
                class="resize-handle"
                picking-mode="Position"
            />

        </ui:VisualElement>


  <ui:Button
    name="open-files-button"
    text="📁"
    class="files-icon-button"
    picking-mode="Position"
/>

  <ui:VisualElement
    name="new-files-icon-badge"
    class="new-files-icon-badge"
    picking-mode="Ignore"
/>

  <ui:Label
    name="drop-toast-label"
    class="drop-toast-label"
    picking-mode="Ignore"
/>


        <ui:VisualElement
            name="code-viewer"
            class="code-viewer"
        >

            <ui:VisualElement
                name="code-header"
                class="code-header"
            >

                <ui:Label
                    name="code-title"
                    text="File.cs"
                    class="code-title"
                />

                <ui:Button
                    name="close-code-button"
                    text="×"
                    class="close-code-button"
                />

            </ui:VisualElement>

            <ui:ScrollView
                name="code-scroll"
                class="code-scroll"
                mode="Vertical"
            >

                <ui:TextField
                    name="code-text"
                    multiline="true"
                    is-read-only="true"
                    class="code-text"
                />

            </ui:ScrollView>

            <ui:VisualElement
                name="code-resize-handle"
                class="resize-handle"
                picking-mode="Position"
            />

        </ui:VisualElement>

    </ui:VisualElement>

</ui:UXML>