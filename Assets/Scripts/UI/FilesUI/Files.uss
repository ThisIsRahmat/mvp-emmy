.files-root {
    flex-grow: 1;

    justify-content: flex-end;
    align-items: flex-start;

    padding-left: 20px;
    padding-bottom: 20px;
}


.files-window {
    display: none;

    position: absolute;
    left: 20px;
    top: 80px;

    width: 360px;
    height: 380px;

    min-width: 260px;
    min-height: 220px;

    flex-grow: 0;
    flex-shrink: 0;

    padding: 12px;

    background-color: rgb(240, 240, 240);
    border-radius: 10px;
}


.resize-handle {
    position: absolute;
    right: 0;
    bottom: 0;

    width: 22px;
    height: 22px;

    background-color: rgb(190, 190, 190);
    border-top-left-radius: 8px;
}


.files-icon-button {
    display: flex;

    position: absolute;
    left: 20px;
    top: 20px;

    width: 42px;
    height: 42px;

    font-size: 20px;
    border-radius: 21px;

    scale: 1 1;
    transition-property: scale;
    transition-duration: 0.15s;
}


.files-icon-button--drop-active {
    scale: 1.18 1.18;
}


.drop-toast-label {
    display: none;

    position: absolute;
    left: 68px;
    top: 30px;

    max-width: 220px;

    padding: 6px 10px;

    font-size: 12px;
    color: rgb(255, 255, 255);

    background-color: rgb(40, 40, 40);
    border-radius: 6px;

    -unity-text-align: middle-left;
}


.files-header {
    flex-direction: row;
    align-items: center;

    margin-bottom: 4px;
}


.files-title {
    flex-grow: 1;

    font-size: 18px;
    -unity-font-style: bold;
}


.selected-count {
    font-size: 11px;
}


.files-description {
    font-size: 12px;

    margin-bottom: 14px;
}


.files-scroll {
    flex-grow: 1;
    min-height: 0;
}


.empty-files-label {
    margin-top: 20px;

    -unity-text-align: middle-center;
}


/* Dynamically-created file row */

.file-row {
    height: 42px;

    flex-direction: row;
    align-items: center;

    margin-bottom: 6px;

    padding-left: 8px;
    padding-right: 8px;

    background-color: rgb(225, 225, 225);

    border-radius: 6px;
}


.file-name {
    flex-grow: 1;

    font-size: 12px;
}


.file-status {
    font-size: 10px;

    margin-right: 8px;

    padding-left: 6px;
    padding-right: 6px;
}


.view-button {
    width: 55px;
    height: 28px;
}



/* Code viewer */

.code-viewer {
    display: none;

    position: absolute;
    left: 120px;
    top: 60px;

    width: 420px;
    height: 420px;

    min-width: 300px;
    min-height: 260px;

    flex-grow: 0;
    flex-shrink: 0;

    padding: 14px;

    background-color: rgb(245, 245, 245);
    border-radius: 10px;

    /* Content must never push the window bigger than this - long
       files/filenames scroll or wrap inside instead. */
    overflow: hidden;
}


.code-header {
    flex-direction: row;
    align-items: flex-start;

    min-height: 36px;

    margin-bottom: 8px;
}

.code-title {
    flex-grow: 1;
    flex-shrink: 1;

    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}


.close-code-button {
    flex-shrink: 0;

    width: 30px;
    height: 30px;
}


.code-scroll {
    flex-grow: 1;
    min-height: 0;
}


.code-text {
    font-size: 11px;
    white-space: normal;
}